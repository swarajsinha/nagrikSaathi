{
  // Cloudflare Workers config for Nagrik Saathi (static site).
  // "npx wrangler deploy" first runs build.py, then uploads the dist/ folder.
  "name": "nagriksaathi",
  "compatibility_date": "2026-11-01",
  "build": { "command": "python3 build.py" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
